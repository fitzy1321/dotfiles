#!/usr/bin/env python3
"""Push it really good. Push to github(origin), codeberg, and gitlab concurrently."""

import asyncio
from typing import Any


async def run_command(cmd: str | bytes) -> dict[str, Any]:  # pyright: ignore[reportExplicitAny]
    proc = await asyncio.create_subprocess_shell(
        cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE
    )
    stdout, stderr = await proc.communicate()
    return {
        "cmd": cmd,
        "returncode": proc.returncode,
        "stdout": stdout.decode().strip(),
        "stderr": stderr.decode().strip(),
    }


async def main() -> None:
    commands = [
        "git push origin main",
        "git push codeberg main",
        "git push gitlab main",
    ]

    results = await asyncio.gather(*(run_command(cmd) for cmd in commands))

    for r in results:
        print(f"$ {r['cmd']}")
        print(f"  exit code: {r['returncode']}")
        if r["stdout"]:
            print(f"  stdout: {r['stdout']}")
        if r["stderr"]:
            print(f"  stderr: {r['stderr']}")
        print()


if __name__ == "__main__":
    asyncio.run(main())
