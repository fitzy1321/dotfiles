#!/usr/bin/env python3.14
"""Push it really good. Push to github(origin), codeberg, and gitlab concurrently."""

import asyncio
from typing import Any


async def run(cmd: str | bytes) -> dict[str, Any]:
    proc = await asyncio.create_subprocess_shell(
        cmd,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.PIPE,
    )
    stdout, stderr = await proc.communicate()
    dstdout = stdout.decode().strip() if stdout else ""
    dstderr = stderr.decode().strip() if stderr else ""

    print(f"{cmd=}  {dstdout=}  {dstderr=}")

    return {
        "cmd": cmd,
        "returncode": proc.returncode,
        "stdout": dstdout,
        "stderr": dstderr,
    }


async def main() -> None:
    results = await asyncio.gather(
        run("git push origin main"),
        run("git push codeberg main"),
        run("git push gitlab main"),
    )

    for r in results:
        print(f"$ {r['cmd']}")
        print(f"  exit code: {r['returncode']}")
        if r["stdout"]:
            print(f"  stdout: {r['stdout']}")
        if r["stderr"]:
            print(f"  stderr: {r['stderr']}")
        print()


if __name__ == "__main__":
    asyncio.run(main())
